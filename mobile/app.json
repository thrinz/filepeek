{
  "expo": {
    "name": "filepeek",
    "slug": "filepeek",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "filepeek",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "dev.filepeek.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.filepeek.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0e14"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b0e14"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "filepeek lets you pick photos and videos to upload to your server.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "owner": "thrinz",
    "extra": {
      "eas": {
        "projectId": "d01be4ee-5e72-4a1f-961b-5c3629329d22"
      }
    }
  }
}
